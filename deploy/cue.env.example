CUE_DB=/var/lib/cue/cue.sqlite3
CUE_PACK=/opt/cue/server/cue/data/show.json
CUE_WEB_DIST=/opt/cue/web/dist
CUE_DEFAULT_TENANT=halcyon
CUE_TENANTS=halcyon
CUE_STRICT_INTEGRATIONS=0
CUE_RENDER_DEVICE=gpu
# The on-site agent: openjiuwen over an OpenAI-compatible endpoint.
CUE_OPENJIUWEN=auto
CUE_LLM_PROVIDER=OpenAI
CUE_LLM_API_BASE=
CUE_LLM_API_KEY=
CUE_LLM_MODEL=
CUE_LLM_TIMEOUT=120
CUE_LLM_SSL_VERIFY=false
CUE_OPENJIUWEN_WARMUP=1
CUE_AGENT_FALLBACK=0
CUE_CORS_ORIGINS=https://cue.example.invalid
CUE_SCHEDULER=1
CUE_SCAN_INTERVAL_MINUTES=1440
CUE_PUBLIC_URL=https://cue.example.invalid
CUE_SHARE_SECRET=replace-with-a-32-byte-secret
CUE_SHARE_TTL_HOURS=72
# Optional delivery. Missing values are recorded as simulated, not errors.
# CUE_SLACK_WEBHOOK=
# CUE_WEBHOOK_URL=
# CUE_WEBHOOK_SECRET=
# CUE_SMTP_HOST=
# CUE_SMTP_USER=
# CUE_SMTP_PASSWORD=
