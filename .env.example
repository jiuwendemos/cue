# CUE on-site API
CUE_DB=./cue-data/cue.sqlite3
CUE_PACK=./server/cue/data/show.json
CUE_WEB_DIST=./web/dist

# The production office and the venue tenant
CUE_DEFAULT_TENANT=halcyon
CUE_TENANTS=halcyon

# Optional: a configured JiuwenSwarm/DeepAgent backend. Without it, the API
# answers deterministically from the show pack and says so.
# CUE_AGENT_BACKEND=jiuwenswarm
# CUE_AGENT_ENDPOINT=http://127.0.0.1:9000/v1/chat/completions
# CUE_AGENT_API_KEY=
# CUE_AGENT_MODEL=cue-looksmith-1.4.0

# Proactive readiness scheduler
CUE_SCHEDULER=0
CUE_SCAN_INTERVAL_MINUTES=1440
CUE_PUBLIC_URL=http://127.0.0.1:8000
CUE_SHARE_SECRET=change-me-before-a-pilot
CUE_SHARE_TTL_HOURS=72
# CUE_BACKUP_DIR=./cue-data/backups

# Optional delivery channels. Missing credentials record a "simulated" delivery.
# CUE_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# CUE_TEAMS_WEBHOOK=https://...
# CUE_WEBHOOK_URL=https://...
# CUE_WEBHOOK_SECRET=
# CUE_SMTP_HOST=smtp.example.invalid
# CUE_SMTP_PORT=587
# CUE_SMTP_USER=
# CUE_SMTP_PASSWORD=
# CUE_EMAIL_FROM=cue@example.invalid
# CUE_SMS_URL=https://sms.example.invalid/send
# CUE_SMS_TOKEN=

# Refuse to report ready unless the agent and a live connector are configured.
CUE_STRICT_INTEGRATIONS=0

# GPU/CPU is the core. NPU is optional local inference for unreleased content.
CUE_RENDER_DEVICE=gpu
# CUE_NPU_ENDPOINT=http://npu-broker:7788

# CORS for the Vite dev server
CUE_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
